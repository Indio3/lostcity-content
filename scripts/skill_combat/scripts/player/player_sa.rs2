def_int $attack_roll = ~player_attack_roll_specific(divide(multiply(%damagetype, 125), 100));
def_int $defence_roll = ~npc_defence_roll_specific(^crush_style);
if (randominc($attack_roll) > randominc($defence_roll)) {
    $maxhit = divide(multiply(%com_maxhit, 150), 100);
    mes("Maxhit: <tostring($maxhit)>");
    if (npc_type = count_draynor & inv_total(inv, garlic) > 0) {
        $maxhit = add($maxhit, 1);
    }
    $damage = randominc(min($maxhit, npc_param(max_dealt)));
    $damage_capped = min($damage, npc_stat(hitpoints));
    ~give_combat_experience(%damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
}
anim(seq_1060, 0);
sound_synth(shatter, 0, 0);
spotanim_pl(spotanim_251, 96, 0);
~npc_retaliate(0);
npc_queue(2, $damage, 0);
npc_anim(npc_param(defend_anim), 20); 
if (npc_param(defend_sound) ! null) {
    sound_synth(npc_param(defend_sound), 0, 20); // delay npc this tick
}
%action_delay = add(map_clock, 5);

[proc,pvm_dragon_dagger_sa]
if(%sa_energy < 250) {
    mes("You don't have enough power left.");
    return;
}
%sa_energy = sub(%sa_energy, 250);
anim(seq_1062, 0);
sound_synth(puncture, 0, 0);
spotanim_pl(spotanim_252, 96, 0);
~pvm_dragon_dagger_hit;
~npc_retaliate(0);
npc_anim(npc_param(defend_anim), 20); 
if (npc_param(defend_sound) ! null) {
    sound_synth(npc_param(defend_sound), 0, 20); // delay npc this tick
}
%action_delay = add(map_clock, 4);
p_delay(0);
~pvm_dragon_dagger_hit;

[proc,pvm_dragon_dagger_hit]
def_int $damage = 0;
def_int $maxhit = %com_maxhit;
def_int $damage_capped = 0;
def_int $attack_roll = ~player_attack_roll_specific(divide(multiply(%damagetype, 115), 100));
def_int $defence_roll = ~npc_defence_roll_specific(%damagetype);
if (randominc($attack_roll) > randominc($defence_roll)) {
    $maxhit = divide(multiply(%com_maxhit, 115), 100);
    mes("Maxhit: <tostring($maxhit)>");
    if (npc_type = count_draynor & inv_total(inv, garlic) > 0) {
        $maxhit = add($maxhit, 1);
    }
    $damage = randominc(min($maxhit, npc_param(max_dealt)));
    $damage_capped = min($damage, npc_stat(hitpoints));
    ~give_combat_experience(%damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
}
npc_queue(2, $damage, 0);
