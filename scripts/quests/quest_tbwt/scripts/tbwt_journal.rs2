[if_button,questlist:tbwt]
def_string $text;

mes("Get TBWT Main: <tostring(~get_tbwt_main_progress())>");
mes("Get TBWT Timfraku Title: <tostring(~get_tbwt_timfraku_title())>");
mes("Get TBWT Tiadeche: <tostring(~get_tbwt_tiadeche_progress())>");
mes("Get TBWT Tamayu: <tostring(~get_tbwt_tamayu_progress())>");
mes("Get TBWT Tinsay: <tostring(~get_tbwt_tinsay_progress())>");
mes("Get TBWT Lubufu: <tostring(~get_tbwt_lubufu_progress())>");
mes("Get TBWT Lubufu Karambwanji Count: <tostring(~get_tbwt_lubufu_karambwanji())>");
mes("Raw TBWT Tiadeche varp: <tostring(%tbwt_tiadeche)>");

if (~get_tbwt_main_progress() < ^tbwt_started) {
    if (%junglepotion = ^junglepotion_complete_after_spoken) {
        $text = append($text, "@dbl@In @dre@Jungle Potion@dbl@, @dre@Trufitus@dbl@ found @dre@Tai Bwo Wannai Village@dbl@ was|");
        $text = append($text, "@dbl@safe to inhabit. To start this quest I must deliver the news|");
        $text = append($text, "@dbl@to @dre@Timfraku@dbl@, Chief of the village.||");
        $text = append($text, "@dbl@To complete this quest I need:|");
        $text = append($text, "@dbl@Level 30 Cooking|");
        $text = append($text, "@dbl@Level 15 Agility|");
        $text = append($text, "@dbl@Level 5 Fishing|");
        $text = append($text, "@dbl@High level Agility and Herblore is a distinct advantage.|");
        $text = append($text, "@dbl@I also need to be able to defeat @dre@level 48 Jogres@dbl@|");
    } else {
        $text = append($text, "@dbl@I can start this quest by speaking to @dre@Timfraku@dbl@, the Chief of|");
        $text = append($text, "@dre@Tai Bwo Wannai Village@dbl@, after completing @dre@Jungle Potion@dbl@.");
    }
    ~quest_journal("Tai Bwo Wannai Trio", $text);
    return;
}

if (~get_tbwt_main_progress() = ^tbwt_complete) {
    $text = append($text, "@dbl@Completed it m8.|");
    ~quest_journal("Tai Bwo Wannai Trio", $text);
    return;
}

if (~get_tbwt_main_progress() = ^tbwt_started) {

    if (~get_tbwt_tamayu_progress() > ^tbwt_tamayu_unknown & ~get_tbwt_tinsay_progress() > ^tbwt_tinsay_unknown & ~get_tbwt_tiadeche_progress() > ^tbwt_tiadeche_unknown) {
        $text = append($text, "@str@I need to find the three sons of Timfraku:|");
    } else {
        $text = append($text, "@dbl@I need to find the three sons of @dre@Timfraku@dbl@:|");
    }

    if (~get_tbwt_tamayu_progress() < ^tbwt_tamayu_intro) {
        $text = append($text, "@dre@Tamayu|");
    } else {
        $text = append($text, "@str@Tamayu|");
    }

    if (~get_tbwt_tinsay_progress() < ^tbwt_tinsay_intro) {
        $text = append($text, "@dre@Tinsay|");
    } else {
        $text = append($text, "@str@Tinsay|");
    }

    if (~get_tbwt_tiadeche_progress() < ^tbwt_tiadeche_intro) {
        $text = append($text, "@dre@Tiadeche||");
    } else {
        $text = append($text, "@str@Tiadeche||");
    }

    $text = append($text, "@dbl@I need to convince them to return to the village.||");

    if (~get_tbwt_tiadeche_progress() > ^tbwt_tiadeche_unknown) {
        $text = append($text, "@dre@Tiadeche:|");
        $text = append($text, "Nothing of interest.||");
    }

    if (~get_tbwt_tinsay_progress() > ^tbwt_tinsay_unknown) {
        $text = append($text, "@dre@Tinsay:|");
        switch_int(~get_tbwt_tinsay_progress()) {
            case ^tbwt_tinsay_intro :
                $text = append($text, "Nothing of interest.||");
            case ^tbwt_tinsay_fetch_bananarum :
                $text = append($text, "@dbl@He requires @dre@banana in Karamja rum@dbl@ to repair the tribal|@dbl@statue||");
            case ^tbwt_tinsay_given_bananarum :
                $text = append($text, "@str@I have given him sliced banana in Karamja rum.||");
            case ^tbwt_tinsay_fetch_seaweedsandwich :
                $text = append($text, "@str@I have given him sliced banana in Karamja rum.||");
                $text = append($text, "@dbl@He requires a @dre@seaweed in monkey skin sandwich to repair|@dre@the tribal statue with.||");
            case ^tbwt_tinsay_given_seaweedsandwich :
                $text = append($text, "@str@I have given him sliced banana in Karamja rum.||");
                $text = append($text, "@str@I have given him a seaweed in monkey skin sandwich.||");
                $text = append($text, "@dbl@He requires a @dre@something else to repair|@dre@the tribal statue with.||");
        }
    }

    if (~get_tbwt_tamayu_progress() > ^tbwt_tamayu_unknown) {
        $text = append($text, "@dre@Tamayu:|");
        switch_int(~get_tbwt_tamayu_progress()) {
            case ^tbwt_tamayu_intro :
                $text = append($text, "Nothing of interest.||");
            case ^tbwt_tamayu_slay_shaikahan :
                $text = append($text, "@dbl@He will only return to the village once he has slain|@dre@Shaikahan@dbl@.||");
        }
    }

    if (~get_tbwt_lubufu_progress() > ^tbwt_lubufu_intro) {
        $text = append($text, "@dre@Lubufu:|");
        switch_int(~get_tbwt_lubufu_progress()) {
            case ^tbwt_lubufu_initialops, ^tbwt_lubufu_asked_what_do :
                $text = append($text, "@str@Lubufu is a crochety old fisherman just south of|@str@Brimhaven.||");
                $text = append($text, "@str@He appears to have a local monopoly over the sale of|@str@Karambwan.||");

            case ^tbwt_lubufu_offered_to_help :
                $text = append($text, "@str@Lubufu is a crochety old fisherman just south of|@str@Brimhaven.||");
                $text = append($text, "@str@He appears to have a local monopoly over the sale of|@str@Karambwan.||");
                $text = append($text, "@dbl@Lubufu has difficulty collecting bait, due to his age. I have|@dbl@offered to help collect bait.||");

            case ^tbwt_lubufu_fetch_karambwanji :
                $text = append($text, "@str@Lubufu is a crochety old fisherman just south of|@str@Brimhaven.||");
                $text = append($text, "@str@He appears to have a local monopoly over the sale of|@str@Karambwan.||");
                $text = append($text, "@str@Lubufu has difficulty collecting bait, due to his age. I have|@str@offered to help collect bait. Lubufu has accepted.||");
                $text = append($text, "@dbl@Apparently the bait is Karambwanji, which shoal in a Holy|@dbl@Lake south of Tai Bwo Wannai.||");
                $text = append($text, "@dbl@I need to give Lubufu 20 Karambwanji.||");
            
            case ^tbwt_lubufu_given_karambwanji :
                $text = append($text, "@str@Lubufu is a crochety old fisherman just south of|@str@Brimhaven.||");
                $text = append($text, "@str@He appears to have a local monopoly over the sale of|@str@Karambwan.||");
                $text = append($text, "@str@Lubufu has difficulty collecting bait, due to his age. I have|@str@offered to help collect bait. Lubufu has accepted.||");
                $text = append($text, "@str@Apparently the bait is Karambwanji, which shoal in a Holy|@str@Lake south of Tai Bwo Wannai.||");
                $text = append($text, "@str@I have given Lubufu 20 Karambwanji.||");
        }
    }

    ~quest_journal("Tai Bwo Wannai Trio", $text);
    return;
}


    $text = append($text, "@str@Tinsay:|");
    $text = append($text, "@str@I have given him sliced banana in Karamja rum.||");
    $text = append($text, "@str@I have given him a seaweed in monkey skin sandwich.||");
    $text = append($text, "@str@I have given him a burnt Jogre bones marinated in|");
    $text = append($text, "@str@Karambwanji paste.||");

    $text = append($text, "@str@Tamayu:|");
    $text = append($text, "@str@He will only return to the village once he has slain|");
    $text = append($text, "@str@Shaikahan. He appears to be having difficulty in the hunt.||");
    $text = append($text, "@str@I have increased his agility to match the Shaikahan's.||");
    $text = append($text, "@str@I have given him a stronger and Karambwan poisoned spear.||");
    $text = append($text, "@str@Tamayu has slain the Shaikahan!||");

    $text = append($text, "@str@Lubufu:|");
    $text = append($text, "@str@Lubufu is a crochety old fisherman just south of|");
    $text = append($text, "@str@Brimhaven.||");
    $text = append($text, "@str@He appears to have a local monopoly over the sale of Karambwan.||");
    $text = append($text, "@str@Lubufu has difficulty collecting bain, due to his age. I have|");
    $text = append($text, "@str@offered to help collect bait. Lubufu has accepted.||");
    $text = append($text, "@str@Apparently the bait is Karambwanji, which shoal in a Holy|");
    $text = append($text, "@str@Lake south of Tai Bwo Wannai.||");
    $text = append($text, "@str@I have given Lubufu 20 Karambwanji.||");
    $text = append($text, "@str@Lubufu has offered to train me as his apprentice.||");
    $text = append($text, "@str@I have accepted Lubufu's offer.||");
