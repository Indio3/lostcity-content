[proc,mm_login]
if(%mm_monkey_child = ^monkey_child_given_bananas & testbit(%mm_bits, ^mm_child_has_toy) = ^false) {
    %mm_bits = setbit(%mm_bits, ^mm_child_has_toy);
}

if(%mm_monkey_child = ^monkey_child_received_talisman & testbit(%mm_bits, ^mm_lost_toy) = ^true) {
    %mm_bits = setbit(%mm_bits, ^mm_child_has_toy);
    %mm_bits = setbit(%mm_bits, ^mm_child_done_crying);
}

