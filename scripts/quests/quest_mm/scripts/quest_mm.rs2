[proc,mm_wearing_greegree]()(boolean)
if(inv_total(worn, mm_monkey_greegree_for_normal_monkey) > 0) {
    return (true);
}
return (false);

[queue,fade_clear]
if_openoverlay(null);

[debugproc,t]
if(p_finduid(uid) = true) @mm_ch2_cutscene;

[debugproc,fo]
if(p_finduid(uid) = true) ~fade_out;

[debugproc,fi]
if(p_finduid(uid) = true) ~fade_in;

[proc,fade_out]
if_setanim(inter_200:com_0, null);
if_openoverlay(inter_200);
if_setobject(inter_200:com_0, fade_to_black_inv, 1000);
if_setanim(inter_200:com_0, fade_out);

[proc,fade_in]
if_setanim(inter_200:com_0, null);
if_openoverlay(inter_200);
if_setobject(inter_200:com_0, fade_to_black_inv, 1000);
if_setanim(inter_200:com_0, fade_in);