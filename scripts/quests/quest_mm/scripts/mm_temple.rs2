[oploc1,mm_temple_trapdoor]
anim(human_pickupfloor, 0);
p_delay(0);
sound_synth(door_open, 0, 0);
loc_change(mm_temple_trapdoor_open, 500);

[oploc1,mm_temple_trapdoor_open]
~fade_out;
p_delay(1);
p_teleport(0_43_143_55_49);
p_delay(0);
~fade_in;
queue(fade_clear, 2, 0);

[oploc2,mm_temple_trapdoor_open]
sound_synth(door_close, 0, 0);
loc_change(mm_temple_trapdoor, 500);

[oploc1,mm_climbing_rope_bottom_temple]
p_delay(0);
anim(human_reachforladder, 0);
p_delay(1);
p_teleport(map_findsquare(0_43_43_55_33, 0, 2, ^map_findsquare_lineofwalk));

[mapzone,0_43_143]
if(gettimer(mm_dungeon_spikes) = -1) {
    settimer(mm_dungeon_spikes, 1);
}
@music_playbyregion(coord);

[mapzoneexit,0_43_143]
if(inzone(0_43_143_0_0, 0_43_143_63_63, coord) = false) {
    cleartimer(mm_dungeon_spikes);
}
