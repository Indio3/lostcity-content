[if_button,questlist:mm]
def_string $text;
if(%mm_main = ^mm_not_started) {
    $text = "@dbl@I can start this quest by speaking to @dre@Denulth@dbl@ in his tent at|@dbl@the @dre@Imperial Guard Camp@dbl@ in @dre@Burthorpe@dbl@ after completing the|@dre@Death Plateau Quest";
    $text = append($text, "||@dbl@To complete this quest I need:|@dre@Level 15 Agility|@dbl@I also need to be able to defeat a @dre@level 113 Troll|@dre@Level 30 Thieving@dbl@ might be useful.");
    ~quest_journal("Monkey Madness", $text);
    return;
}

$text = append($text, "@dre@Chapter 1:||");

if(%mm_main > ^mm_shown_seal) {
    $text = append($text, "@str@I have found that the 10th squad were indeed blown off|");
    $text = append($text, "@str@course and never reached the shipyard. I am currently on a|");
    $text = append($text, "@str@mission for King Narnode Shareen to investigate their|");
    $text = append($text, "@str@whereabouts.");
} else {
    if(%mm_narnode > 0) {
        $text = append($text, "@dre@King Narnode Shareen:||");
        $text = append($text, "@str@The 10th squad of Narnode's Royal Guard went missing during|");
        $text = append($text, "@str@a mission to decommission Glough's ship building facilities|");
        $text = append($text, "@str@in Karamja.||");
        $text = append($text, "@str@Narnode has asked if I would find out if the 10th squad ever|");
        $text = append($text, "@str@reached the shipyard.||");

        if(%mm_narnode >= ^narnode_given_seal) {
            $text = append($text, "@str@Narnode has given me a copy of the Royal Seal so that I may|");
            $text = append($text, "@str@identify myself as his envoy.||");
        }


        if(%mm_caranock > ^mm_caranock_p2) $text = append($text, "@str@I have investigated the Karamjan shipyard.||");
        else $text = append($text, "@dbl@I have agreed to investigate the @dre@Karamjan@dbl@ shipyard.||");

        if(%mm_narnode >= ^narnode_received_orders) {
            $text = append($text, "@str@Narnode has given me some handwritten orders.||");
            if(%mm_daero > 0) $text = append($text, "@str@I have taken the orders to Daero.||");
            else $text = append($text, "@dbl@I must take the orders to the new High Tree @dbl@Guardian,|@dre@Daero@dbl@, @dbl@who works on the @dre@Grand Tree@dbl@.||");
        }
    }

    if(%mm_caranock > 0) {
        $text = append($text, "@dre@G.L.O. Caranock:||");
        if(testbit(%mm_bits, ^mm_spoke_foreman) = ^true) $text = append($text, "@str@The foreman told me that Caranock is the Gnome Liason|@str@Officer at the shipyard.||");
        $text = append($text, "@str@I have told Caranock that the 10th squad are missing.||");
        if(%mm_caranock > ^mm_asked_caranock) { // recheck this stage
            $text = append($text, "@str@Caranock said that the 10th squad never made it to the|");
            $text = append($text, "@str@shipyard. He mentioned something about seriously strong|");
            $text = append($text, "@str@southern winds.||");
            // doesnt check for next stage, confirmed on osrs
            if(%mm_narnode >= ^narnode_returned_shipyard) $text = append($text, "@str@I have reported back to King Narnode.||");
            else $text = append($text, "@dbl@I should report back to @dre@King Narnode@dbl@.||");
        }
    }

    if(%mm_daero > 0) {
        $text = append($text, "@dre@High Tree Guardian Daero:||");
        $text = append($text, "@str@I found Daero 'working' in the Grand Tree Bar.");
        if(%mm_daero > ^daero_found) {
            $text = append($text, "||@str@I have given Narnode's orders to Daero.");
        }
        if(%mm_daero > ^daero_given_orders) {
            $text = append($text, "||@str@The orders say I am to undertake a reconnaisance mission|");
            $text = append($text, "@str@far to the south of Karamja to investigate Caranock's|");
            $text = append($text, "@str@claim that Garkor's squad were blown off course.");
        }
        if(%mm_daero > ^daero_learnt_mission) {
            $text = append($text, "||@str@I have been taken to the Underground Military Glider @str@Hangar.");
        }

        if(%mm_daero > ^daero_started_reinit) {
            $text = append($text, "||@str@I have completed reinitialisation.");
        } else if(%mm_daero = ^daero_started_reinit) {
            $text = append($text, "||@dbl@I cannot go on the mission until reinitialisation has been|@dbl@completed.");
        }

    }

    if(%mm_waydar > 0) {
        $text = append($text, "||@dre@Flight Commander Waydar:||");
        $text = append($text, "@str@Waydar and I landed our glider on a small island far to the|@str@south of Karamja.");
        
    }

    if(%mm_lumdo > 0) {
        $text = append($text, "||@dre@Foot Soldier Lumdo:||");
        $text = append($text, "@str@I found Lumdo standing on a beach near ten crashed gnome|@str@gliders.");

        if(%mm_lumdo > ^lumdo_proof) {
            $text = append($text, "||@str@Lumdo said the 10th squad were blown off course to the|");
            $text = append($text, "@str@south before they ever reached the shipyard. After|");
            $text = append($text, "@str@crashing on a small island, they collected enough wood to|");
            $text = append($text, "@str@make two boats. All the squad, apart from Lumdo, sailed to|");
            $text = append($text, "@str@the larger island to the west. Lumdo was left to|");
            $text = append($text, "@str@guard the crashed gliders.");
        }

        $text = append($text, "||@dbl@I have asked to be taken to the western island, but @dre@Lumdo@dbl@|@dbl@refuses to leave his post.");
        
    }
}

if(%mm_main > ^mm_shown_seal) {
    // https://youtu.be/Qr9nNWqN6Y8?si=IqgynfD_0FE87fSR&t=950
    $text = append($text, "||@dre@Chapter 2:");

    if(%mm_jail_counter > 0) {
        $text = append($text, "||@str@I have made my rather painful way to a large village|");
        $text = append($text, "@str@populated by various types of monkey.");

        if(%mm_jail_counter > 1) {
            $text = append($text, "||@str@I have been caught and jailed <tostring(%mm_jail_counter)> times.");
        }
    }

    if(%mm_garkor > 0) {
        $text = append($text, "||@dre@Sergeant Garkor:||");
        $text = append($text, "@str@I found Sergeant Gakor hiding towards the east of the village.|");
        $text = append($text, "@str@Having eavesdropped on Awowogei's plans, he has come to|");
        $text = append($text, "@str@the conclusion that they need a monkey on the inside.|");
        
        if(%mm_garkor = ^garkor_speak_zooknock) {
            if(%mm_zooknock > ^zooknock_learned_story) {
                $text = append($text, "||@str@I have seen Zooknock about the so called monkey 'disguise'.");
            } else {
                $text = append($text, "||@dbl@I must see the squad mage, @dre@Zooknock@dbl@, about obtaining a|");
                $text = append($text, "@dbl@monkey disguise.|");
            }
        }
    }

    if(%mm_zooknock > 0) {
        $text = append($text, "||@dre@High Mage Zooknock:||");
        $text = append($text, "@str@I found Zooknock and the sappers Waymottin and Bunkwicket|");
        $text = append($text, "@str@working at the end of an underground cave system.");

        if(%mm_zooknock > ^zooknock_told_story) {
            $text = append($text, "||@str@Zooknock and the sappers are attempting to tunnel their way|");
            $text = append($text, "@str@beneath the jail. However, progress is slow.");
        }

        if(%mm_zooknock > ^zooknock_learned_story) {
            $text = append($text, "||@str@Zooknock is capable of transforming my body into that of a|");
            $text = append($text, "@str@monkey. He can also help me communicate with the monkeys.");
        }

        if(%mm_zooknock = ^zooknock_need_items) {
            $text = append($text, "||@dbl@I am collecting items for @dre@Zooknock@dbl@ so that he may cast his|@dbl@spells.");

            if(testbit(%mm_bits, ^mm_made_amulet) = ^false) {
                $text = append($text, "||@dbl@For the monkey amulet I still need to give him:");
            } else {
                $text = append($text, "||@str@For the monkey amulet I needed to give him:");
            }
            if(testbit(%mm_bits, ^mm_given_gold_bar) = ^true) {
                $text = append($text, "|@str@ - A gold bar.");
            } else {
                $text = append($text, "|@dre@ - A gold bar.");
            }

            if(testbit(%mm_bits, ^mm_given_mould) = ^true) {
                $text = append($text, "|@str@ - A monkey amulet mould.");
            } else {
                $text = append($text, "|@dre@ - A monkey amulet mould.");
            }

            if(testbit(%mm_bits, ^mm_given_dentures) = ^true) {
                $text = append($text, "|@str@ - Something to do with monkey speech.");
            } else {
                $text = append($text, "|@dre@ - Something to do with monkey speech.");
            }

            $text = append($text, "||@dbl@For the monkey talisman I still need:");

            if(testbit(%mm_bits, ^mm_given_talisman) = ^true) {
                $text = append($text, "|@str@ - An authentic magical monkey talisman.");
            } else {
                $text = append($text, "|@dre@ - An authentic magical monkey talisman.");
            }

            if(testbit(%mm_bits, ^mm_given_remains) = ^true) {
                $text = append($text, "|@str@ - Some kind of monkey remains.");
            } else {
                $text = append($text, "|@dre@ - Some kind of monkey remains.");
            }
        }
    }

    if(%mm_monkey_child > 0) {
        $text = append($text, "||@dre@The Monkey Child:||");
        $text = append($text, "@str@I have found a monkey child in a banana grove to the|@str@west of");
        $text = append($text, " the village. For some reason, it does not|@str@seem afraid of me. I");
        $text = append($text, " must be careful when talking to it,|@str@however, as its Aunt keeps");
        $text = append($text, " a close watch.");
    }

}
~quest_journal("Monkey Madness", $text);