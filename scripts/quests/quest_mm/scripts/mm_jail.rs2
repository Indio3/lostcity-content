[oploc1,mm_jail_door]
mes("You attempt to pick the lock.");
p_delay(2);
mes("You manage to pick the lock.");
if(stat_random(thieving, 96, 250) = false) { // TODO: actual rate
    mes("You fail to pick the lock.");
    return;
}
sound_synth(locked, 0, 0);
~open_and_close_door2(mm_jail_door_inactive, ~check_axis(coord, loc_coord, loc_angle), iron_door_open);

[oploc1,mm_jail_door_unpickable]
mes("You attempt to pick the lock.");
p_delay(2);
mes("You fail to pick the lock.");

[opnpc1,mm_aberab]
~chatnpc("<p,angry>grr");

[opnpc1,mm_trefaji]
~chatnpc("<p,angry>grr");

[ai_spawn,mm_trefaji]
%npc_int = 101;

[ai_timer,mm_aberab]
~mm_jail_patrol;

[ai_timer,mm_trefaji]
~mm_jail_patrol;

[queue,aa_jail_knockout]
~fade_out;
p_delay(3);
walktrigger(clear_seq);
clearqueue(aa_knockout);
p_telejump(0_43_43_18_42);
~fade_in;
p_delay(4);
%mm_jail_counter = add(%mm_jail_counter, 1);
if_openoverlay(null);
@lumo_jailed_dialogue;

[proc,mm_jail_patrol]
npc_say("<tostring(%npc_int)>");
def_coord $dest;
def_coord $npc_center;
def_int $dir;
def_int $dist;
huntall(npc_coord, 1, ^vis_lineofsight);
if(huntnext = true) {
    if(~mm_wearing_greegree = false) {
    if_close;
    npc_facesquare(coord);
    if(p_finduid(uid) = true) {
        p_delay(0);
        npc_anim(m_gorilla_attack, 0);
        sound_synth(gorilla_bigpunch, 0, 0);
        $dest = coord;
        $npc_center = movecoord(npc_coord, 1, 0, 1);
        $dir = ^exact_east;
        anim(human_mm_flyback, 20);
        if(coordx(coord) < coordx($npc_center) & coordz(coord) = coordz($npc_center)) {
            // west
            $dir = ^exact_east;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord($npc_center, multiply($dist, -1), 0, 0);
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } else if(coordx(coord) > coordx($npc_center) & coordz(coord) = coordz($npc_center)) {
            // east
            $dir = ^exact_west;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord($npc_center, $dist, 0, 0);
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } else if(coordz(coord) > coordz($npc_center) & coordz(coord) = coordz($npc_center)) {
            // north
            $dir = ^exact_south;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord($npc_center, 0, 0, $dist);
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } else if(coordz(coord) < coordz($npc_center) & coordz(coord) = coordz($npc_center)) {
            // south
            $dir = ^exact_south;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord($npc_center, 0, 0, multiply($dist, -1));
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } if(coordx(coord) > coordx($npc_center) & coordz(coord) > coordz($npc_center)) {
            // northeast
            $dir = ^exact_south;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord($npc_center, $dist, 0, $dist);
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } else if(coordx(coord) < coordx($npc_center) & coordz(coord) > coordz($npc_center)) {
            // northwest
            $dir = ^exact_south;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord($npc_center, multiply($dist, -1), 0, $dist);
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } else if(coordx(coord) > coordx($npc_center) & coordz(coord) < coordz($npc_center)) {
            // southeast
            $dir = ^exact_north;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord($npc_center, $dist, 0, multiply($dist, -1));
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } else if(coordx(coord) < coordx($npc_center) & coordz(coord) < coordz($npc_center)) {
            // southwest
            $dir = ^exact_north;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord($npc_center, multiply($dist, -1), 0, multiply($dist, -1));
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        }
        ~damage_self(~random_range(1, 10));
        if(lineofwalk(coord, $dest) = true & coord ! $dest) {
            p_exactmove(coord, $dest, 20, 40, $dir);
        }
        queue(aa_jail_knockout, 0, 0);
        p_delay(0);
    }
    }
}
if(%npc_int < 3) {
    npc_setmode(none);
    npc_walk(npc_coord);
    npc_walk(0_43_43_18_46);
} else if(%npc_int < 7) {
