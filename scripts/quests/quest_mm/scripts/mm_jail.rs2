%npc_int = add(%npc_int, 1);
if(inzone(0_43_43_12_48, 0_43_43_17_52, npc_coord) = true) {
    if(npc_getmode = none & %npc_int >= 72) {
        if(.npc_find(npc_coord, npc_param(next_npc_type), 5, 0) = true) {
            .%npc_int = 0;
            npc_setmode(wander);
        }
    }
}
