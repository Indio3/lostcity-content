[oploc1,horror_jumping_spot1] @jump_basalt(0_39_56_26_11, 0_39_56_26_13, ^exact_north);
[oploc1,horror_jumping_spot2] @jump_basalt(0_39_56_26_13, 0_39_56_26_11, ^exact_south);
[oploc1,horror_jumping_spot3] @jump_basalt(0_39_56_26_16, 0_39_56_26_18, ^exact_north);
[oploc1,horror_jumping_spot4] @jump_basalt(0_39_56_26_18, 0_39_56_26_16, ^exact_south);
[oploc1,horror_jumping_spot5] @jump_basalt(0_39_56_22_27, 0_39_56_20_27, ^exact_west);
[oploc1,horror_jumping_spot6] @jump_basalt(0_39_56_20_27, 0_39_56_22_27, ^exact_east);
[oploc1,horror_jumping_spot7] @jump_basalt(0_39_56_18_29, 0_39_56_18_31, ^exact_north);
[oploc1,horror_jumping_spot8] @jump_basalt(0_39_56_18_31, 0_39_56_18_29, ^exact_south);
[oploc1,horror_jumping_spot9] @jump_basalt(0_39_56_18_33, 0_39_56_18_35, ^exact_north);
[oploc1,horror_jumping_spot10] @jump_basalt(0_39_56_18_35, 0_39_56_18_33, ^exact_south);

[aploc1,horror_jumping_spot1] @jump_basalt_ap(0_39_56_26_13, 0_39_56_26_11, ^exact_south);
[aploc1,horror_jumping_spot2] @jump_basalt_ap(0_39_56_26_11, 0_39_56_26_13, ^exact_north);
[aploc1,horror_jumping_spot3] @jump_basalt_ap(0_39_56_26_18, 0_39_56_26_16, ^exact_south);
[aploc1,horror_jumping_spot4] @jump_basalt_ap(0_39_56_26_16, 0_39_56_26_18, ^exact_north);
[aploc1,horror_jumping_spot5] @jump_basalt_ap(0_39_56_20_27, 0_39_56_22_27, ^exact_east);
[aploc1,horror_jumping_spot6] @jump_basalt_ap(0_39_56_22_27, 0_39_56_20_27, ^exact_west);
[aploc1,horror_jumping_spot7] @jump_basalt_ap(0_39_56_18_31, 0_39_56_18_29, ^exact_south);
[aploc1,horror_jumping_spot8] @jump_basalt_ap(0_39_56_18_29, 0_39_56_18_31, ^exact_north);
[aploc1,horror_jumping_spot9] @jump_basalt_ap(0_39_56_18_35, 0_39_56_18_33, ^exact_south);
