[aploc1,horror_jumping_spot1]
if(lineofwalk(coord, loc_coord) = true & distance(coord, loc_coord) > 1) {
    p_aprange(1);
    return;
}
if(lineofwalk(coord, loc_coord) = false) {
    if(coord ! 0_39_56_26_13) {
        p_aprange(2);
        return;
    }
    p_delay(0);
    ~agility_exactmove(human_steppingstonejump, 19, 1, 0_39_56_26_13, 0_39_56_26_11, 47, 59, ^exact_south, false);
    sound_synth(jump_no_land, 0, 0);
} else {
    if(coord ! 0_39_56_26_11) {
        p_delay(0);
        p_teleport(0_39_56_26_11);
        p_delay(1);
    }
    ~agility_exactmove(human_steppingstonejump, 19, 1, 0_39_56_26_11, 0_39_56_26_13, 47, 59, ^exact_north, false);
    sound_synth(jump_no_land, 0, 0);
}

