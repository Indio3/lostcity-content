[opnpc1,_category_632] 
@attempt_fish_karambwanji;
[opnpc4,_category_632] 
@fish_karambwanji;

[opnpcu,_category_632]
switch_obj(last_useitem) {
    case net : p_opnpc(1);
    case default : @fishing_wrong_spot_message(last_useitem);
}

[opnpc1,_category_633] 
@attempt_fish_karambwan;

[opnpcu,_category_633]
switch_obj(last_useitem) {
    case tbwt_karambwan_vessel_loaded_with_karambwanji : p_opnpc(1);
    case tbwt_karambwan_vessel : ~mesbox("You need to load your vessel with a karambwanji to fish here.");
    case default : @fishing_wrong_spot_message(last_useitem);
}

[label,attempt_fish_karambwanji]
// check if they have fishing equipment
if (~check_fish_equipment(net) = false) {
    return;
}
// check if inv is full
if (inv_freespace(inv) < 1) {
    anim(null, 0);
    ~mesbox("You can't carry any more fish.");
    return;
}
if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + 4);
    p_opnpc(1);
    return;
} 
if (%action_delay = calc(map_clock + 3)) {
    mes("You cast out your net...");
    anim(human_smallnet, 0);
    sound_synth(net, 0, 0);
    p_opnpc(4);
} else if (%action_delay = map_clock) {
    if (stat(fishing) >= 5) {
        ~fish_roll(raw_shrimp, tbwt_raw_karambwanji, net, null);
    } else {
        ~fish_roll(raw_shrimp, null, net, null);
    }
}

if (afk_event = ^true & npc_param(is_whirlpool) = ^false) {
    @macro_event_fishing(net);
}

[label,fish_karambwanji]
// check if they have fishing equipment
if (~check_fish_equipment(net) = false) {
    return;
}
// check if inv is full again
if (inv_freespace(inv) < 1) {
    anim(null, 0);
    ~mesbox("You can't carry any more fish.");
    return;
}
if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + 5);
} else if (%action_delay = map_clock) {
    anim(human_smallnet, 0);
    if (stat(fishing) >= 5) {
        ~fish_roll(raw_shrimp, tbwt_raw_karambwanji, net, null);
    } else {
        ~fish_roll(raw_shrimp, null, net, null);
    }
}
p_opnpc(4);

[label,attempt_fish_karambwan]
if (stat(fishing) < 65) {
    anim(null, 0);
    mes("You need to be at least level 65 Fishing to catch Karambwan.");
    return;
}
if (inv_total(inv, tbwt_karambwan_vessel) > 0 & inv_total(inv, tbwt_karambwan_vessel_loaded_with_karambwanji) = 0) {
    // Only show message on the initial click (not during the loop)
    if (%action_delay < map_clock) {
        ~mesbox("You need to load your vessel with a karambwanji to fish here.");
    }
    return;
}
if (~check_fish_equipment(tbwt_karambwan_vessel_loaded_with_karambwanji) = false) {
    return;
}
if (inv_freespace(inv) < 1) {
    anim(null, 0);
    ~mesbox("You can't carry any more Karambwan.");
    return;
}

anim(human_octopus_pot, 0);

if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + 4);
    mes("You lower the Karambwan vessel.");
    sound_synth(fishing_cast, 0, 0);
    p_opnpc(1);
    return;
} 
if (%action_delay <= map_clock) {
    mes("Rolling - map_clock: <tostring(map_clock)>");
    ~fish_roll(tbwt_raw_karambwan, null, tbwt_karambwan_vessel_loaded_with_karambwanji, null);
    %action_delay = calc(map_clock + 4);
}
p_opnpc(1);

if (afk_event = ^true & npc_param(is_whirlpool) = ^false) {
    @macro_event_fishing(tbwt_karambwan_vessel_loaded_with_karambwanji);
}
